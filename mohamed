def init_db():
    conn = sqlite3.connect("teacher_smart_bot.db")
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS timetable (
            user_id INTEGER PRIMARY KEY,
            schedule_text TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS memo_template (
            user_id INTEGER PRIMARY KEY,
            template_text TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS annual_distributions (
            user_id INTEGER,
            subject_name TEXT,
            distribution_text TEXT,
            PRIMARY KEY (user_id, subject_name)
        )
    """)
    conn.commit()
    conn.close()

