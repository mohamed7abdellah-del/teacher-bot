@dp.message(TeacherState.waiting_for_subject_name)
async def get_subject_name(message: types.Message, state: FSMContext):
    await state.update_data(subject=message.text)
    await state.set_state(TeacherState.waiting_for_distribution)
    await message.answer(f"ممتاز. الآن أرسل **التوزيع السنوي** لمادة ({message.text}) كملف PDF أو نص:")

@dp.message(TeacherState.waiting_for_distribution, F.document | F.text)
async def save_distribution(message: types.Message, state: FSMContext):
    user_id = message.from_user.id
    data = await state.get_data()
    subject = data.get("subject")
    dist_text = ""
    if message.document:
        file = await bot.get_file(message.document.file_id)
        downloaded = await bot.download_file(file.file_path)
        temp_name = f"dist_{user_id}.pdf"
        with open(temp_name, "wb") as f:
            f.write(downloaded.read())
        try:
            reader = PyPDF2.PdfReader(temp_name)
            for page in reader.pages:
                dist_text += page.extract_text() + "\n"
        except:
            dist_text = "ملف توزيع سنوي."
        finally:
            if os.path.exists(temp_name): os.remove(temp_name)
    else:
        dist_text = message.text

    conn = sqlite3.connect("teacher_smart_bot.db")
    cursor = conn.cursor()
    cursor.execute("REPLACE INTO annual_distributions (user_id, subject_name, distribution_text) VALUES (?, ?, ?)", (user_id, subject, dist_text))
    conn.commit()
    conn.close()
    await state.clear()
    await message.answer(f"✅ **تم حفظ التوزيع السنوي لـ ({subject}) بنجاح!**")

