@dp.callback_query(F.data == "upload_timetable")
async def ask_timetable(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(TeacherState.waiting_for_timetable)
    await callback.message.answer("⏰ **تسجيل استعمال الزمن:**\n\nأرسل جدول حصصك وتوزيع المواد على المستويات الثلاثة:")
    await callback.answer()

@dp.message(TeacherState.waiting_for_timetable)
async def save_timetable(message: types.Message, state: FSMContext):
    user_id = message.from_user.id
    conn = sqlite3.connect("teacher_smart_bot.db")
    cursor = conn.cursor()
    cursor.execute("REPLACE INTO timetable (user_id, schedule_text) VALUES (?, ?)", (user_id, message.text))
    conn.commit()
    conn.close()
    await state.clear()
    await message.answer("✅ **تم حفظ استعمال الزمن بنجاح!**")

@dp.callback_query(F.data == "upload_template")
async def ask_template(callback: types.CallbackQuery, state: FSMContext):
    await state.set_state(TeacherState.waiting_for_template)
    await callback.message.answer("📄 **رفع نموذج المذكرة الفارغ:**\n\nأرسل ملف الـ Word (`.docx`) أو نص النموذج الذي يحتوي على خانات مذكرتك:")
    await callback.answer()

@dp.message(TeacherState.waiting_for_template, F.document | F.text)
async def save_template(message: types.Message, state: FSMContext):
    user_id = message.from_user.id
    content = ""
    if message.document:
        file = await bot.get_file(message.document.file_id)
        downloaded = await bot.download_file(file.file_path)
        temp_name = f"template_{user_id}.docx"
        with open(temp_name, "wb") as f:
            f.write(downloaded.read())
        try:
            doc = docx.Document(temp_name)
            for p in doc.paragraphs:
                content += p.text + "\n"
        except:
            content = "خطأ في قراءة ملف الورد."
        finally:
            if os.path.exists(temp_name): os.remove(temp_name)
    else:
        content = message.text

    conn = sqlite3.connect("teacher_smart_bot.db")
    cursor = conn.cursor()
    cursor.execute("REPLACE INTO memo_template (user_id, template_text) VALUES (?, ?)", (user_id, content))
    conn.commit()
    conn.close()
    await state.clear()
    await message.answer("✅ **تم حفظ نموذج المذكرة الفارغ وتحليل خاناته بنجاح!**")

@dp.callback_query(F.data == "upload_distribution")
